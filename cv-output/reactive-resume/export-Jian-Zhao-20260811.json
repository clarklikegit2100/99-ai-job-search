        {
          "id": "48e337e6-a0c7-4f7f-b7e6-e4649a1dd4e6",
          "hidden": false,
          "company": "Temple University, College of Public Health",
          "position": "Assistant Research Scientist",
          "location": "Philadelphia, PA",
          "period": "Oct 2023–Apr 2025",
          "website": {
            "url": "",
            "label": "",
            "inlineLink": false
          },
          "description": "<ul><li>Developed EMMA, an LLM-based assistant for postpartum-depression support using LLaMA/ChatGPT, RAG, PEFT, Milvus, Neo4j, Flowise, Gradio, and Streamlit to connect users with locally relevant resources</li><li>Applied Random Forest, XGBoost, and SVM to ambulatory-visit and public-health data, identifying blood-pressure and A1C monitoring gaps and supporting hypertension-prediction research</li><li>Designed AI and data workflows spanning EHR, environmental sensors, and public-health repositories; contributed manuscripts, grant proposals, technical documentation, and cross-disciplinary research supervision</li></ul>",
          "roles": []
        },
        {
          "id": "e2cb3380-cf07-4ea3-803e-d375aecff811",
          "hidden": false,
          "company": "Delaware State University",
          "position": "Ph.D. Research Assistant",
          "location": "Dover, DE",
          "period": "Aug 2019–Present",
          "website": {
            "url": "",
            "label": "",
            "inlineLink": false
          },
          "description": "<ul><li>Research biomedical cell segmentation, tracking, and quantification using mathematical algorithms, image processing, CNNs, GNNs, and LLM-assisted parameter tuning for microscopy applications</li><li>Developed a rapid-tuning approach for CSTQ parameters supporting reproducible biomedical image-analysis and disease-research workflows</li><li>Conduct large-scale nano-bio spectroscopy and plasma simulations using MPI, OpenMP, GPU computing, OSIRIS, and GROMACS in collaborations with Princeton, UCLA, and Lawrence Livermore National Laboratory</li></ul>",
          "roles": []
        },
        {
